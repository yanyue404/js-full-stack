# 复制为 .env 后修改；docker compose 会自动读取同目录的 .env（已被 .gitignore 忽略）
DB_PASSWORD=change-me
# 至少 32 位随机字符串：openssl rand -hex 32
JWT_SECRET=
HTTP_PORT=8000
LOG_LEVEL=info
GRAFANA_PASSWORD=admin

# AI 任务拆解（可选，不填则走规则兜底）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 服务器部署时使用 CI 推送到 GHCR 的镜像
# API_IMAGE=ghcr.io/yanyue404/js-full-stack/teamboard-api:latest
# WEB_IMAGE=ghcr.io/yanyue404/js-full-stack/teamboard-web:latest
