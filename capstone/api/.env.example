PORT=8080
# 不配置则使用本地 PGlite（./.pglite），无需 Docker
DATABASE_URL=postgresql://teamboard:teamboard@localhost:5432/teamboard
# 生产环境必须设置，至少 32 位
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
LOG_LEVEL=info

# AI 任务拆解（可选）：不配置则使用规则兜底
OPENAI_API_KEY=
# OpenAI 兼容接口地址，例如 https://api.deepseek.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
